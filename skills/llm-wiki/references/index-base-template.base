filters:
  and:
    - file.ext == "md"
    - file.folder.startsWith("wiki/")
    - file.basename != "index"
    - file.basename != "log"
    - file.basename != "_index"

formulas:
  topic_primary: if(topics, topics[0], "uncategorized")

properties:
  title:
    displayName: Title
  summary:
    displayName: Summary
  catalog:
    displayName: Catalog
  status:
    displayName: Status
  review_by:
    displayName: Review by
  superseded_by:
    displayName: Superseded by
  topics:
    displayName: Topics
  updated:
    displayName: Updated
  archived:
    displayName: Archived
  formula.topic_primary:
    displayName: Topic

views:
  - type: table
    name: Active
    filters:
      and:
        - status == "active"
    order:
      - title
      - catalog
      - formula.topic_primary
      - updated
      - review_by
  - type: table
    name: All articles
    order:
      - title
      - summary
      - formula.topic_primary
      - updated

  - type: table
    name: By topic
    groupBy:
      property: formula.topic_primary
      direction: ASC
    order:
      - title
      - summary
      - updated

  - type: table
    name: Recently updated
    limit: 25
    order:
      - title
      - summary
      - formula.topic_primary
      - updated

  - type: table
    name: Archived only
    filters:
      and:
        - archived == true
    order:
      - title
      - summary
      - updated

  - type: table
    name: Open questions
    filters:
      and:
        - open_questions == true
        - archived != true
    order:
      - title
      - summary
      - formula.topic_primary
      - updated

  - type: table
    name: Orphans
    filters:
      and:
        - file.backlinks.isEmpty()
        - archived != true
    order:
      - title
      - formula.topic_primary
      - updated
  - type: table
    name: Review due
    filters:
      and:
        - status == "active"
        - review_by <= today()
    order:
      - title
      - formula.topic_primary
      - type
      - review_by
      - updated
  - type: table
    name: Superseded and merged
    filters:
      and:
        - status != "active"
    order:
      - title
      - status
      - superseded_by
      - formula.topic_primary
      - updated
